#!/bin/sh
# Sign in to a CLI with a browser login.
set -eu
case "${1:-}" in
  claude)
    dir="${STOKE_CLAUDE_READER_DIR:-/data/claude-reader}"
    mkdir -p -m 700 "$dir"
    exec env -u CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CONFIG_DIR="$dir" claude auth login
    ;;
  antigravity)
    echo "Open the URL, sign in, then paste the code here within 60 seconds (run again if it times out)." >&2
    exec env -u CLAUDE_CODE_OAUTH_TOKEN AGY_CLI_DISABLE_AUTO_UPDATE=true agy -p /usage
    ;;
  *) echo "usage: stoke-login claude|antigravity" >&2; exit 2 ;;
esac
