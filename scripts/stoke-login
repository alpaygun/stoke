#!/bin/sh
# Sign the no-message Claude usage reader in with a browser login, kept apart from the stoke token.
set -eu
case "${1:-}" in
  claude)
    dir="${STOKE_CLAUDE_READER_DIR:-/data/claude-reader}"
    mkdir -p -m 700 "$dir"
    exec env -u CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CONFIG_DIR="$dir" claude auth login
    ;;
  *) echo "usage: stoke-login claude" >&2; exit 2 ;;
esac
