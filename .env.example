# Dry run is on unless this value is exactly 0, false, or no.
STOKE_DRY_RUN=1
# Enabled tools, in display order.
STOKE_TOOLS=claude,codex
# Default auto-stoke for tools with no saved state.
STOKE_AUTO_DEFAULT=1
# IANA time zone used for local plan times.
STOKE_TIMEZONE=Europe/Istanbul
# Seconds to wait after a window reset; failure backoff (last value repeats).
STOKE_DELAY_SECONDS=90
STOKE_RETRY_SECONDS=60,300,900,1800,3600
# Maximum duration of each official CLI command.
STOKE_TIMEOUT_SECONDS=180
# Seconds between no-stoke usage reads for tools that support them (Codex).
STOKE_REFRESH_SECONDS=900
# State file and empty CLI workdir (container path).
STOKE_DATA_DIR=/data
# Listen address and port inside the container.
STOKE_HOST=0.0.0.0
STOKE_PORT=8787
# Host address and port published by Compose. Keep the host off the LAN; use the
# Docker bridge gateway (e.g. 172.17.0.1) only when a tunnel container must reach it.
STOKE_PUBLISH_HOST=127.0.0.1
STOKE_PUBLISH_PORT=8787
# Synthetic window duration and comma-separated dry-run failures.
STOKE_DRY_RUN_WINDOW_SECONDS=18000
STOKE_DRY_RUN_FAIL=
# Obtain the real token with claude setup-token; never commit the real token.
CLAUDE_CODE_OAUTH_TOKEN=
# Persistent device-auth credentials; run codex login --device-auth in the container.
CODEX_HOME=/home/stoke/.codex
